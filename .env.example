# توکن ربات تلگرام (از @BotFather دریافت کنید)
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_telegram_bot_token_here

# کلید رایگان Groq (برای تبدیل سریع ویس به متن با Whisper-large-v3 و خلاصه‌سازی رزرو با Llama 3.3)
# دریافت رایگان از: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# کلید رایگان Google Gemini (برای خلاصه‌سازی هوشمند فارسی و انگلیسی با Gemini 2.0 Flash)
# دریافت رایگان از: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# (اختیاری) کلید رایگان OpenRouter (به عنوان لایه سوم Fallback خلاصه‌سازی)
# دریافت از: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# (اختیاری) کلید رایگان Cloudflare Workers AI (به عنوان لایه دوم Fallback تبدیل صوت به متن)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# تنظیمات اختیاری
MAX_FILE_SIZE_MB=20
TRANSCRIPT_CACHE_TTL_SECONDS=3600
TRANSCRIPT_CACHE_MAX_ITEMS=500
